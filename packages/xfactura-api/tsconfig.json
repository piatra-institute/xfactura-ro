{
  "compilerOptions": {
    "target": "es2022",
    "lib": [
      "esnext",
      "dom"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "types": [
      "bun"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "drizzle.config.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
