DATABASE_URL=file:.accounting/xfactura.db
# For Turso, use the database URL and its scoped token instead of a local file.
DATABASE_AUTH_TOKEN=
# bun run setup generates a random secret when this value is empty.
ACCOUNTING_AUTH_SECRET=
ACCOUNTING_PUBLIC_URL=http://localhost:3000
# Extra internal Host names used by a reverse proxy; no wildcard or forwarded-header trust.
ACCOUNTING_MCP_PROXY_HOSTS=
ACCOUNTING_OBJECT_DIR=.accounting/objects
# The application registered on ANAF's portal (OAuth); leave empty to keep the SPV offline.
ACCOUNTING_ANAF_CLIENT_ID=
ACCOUNTING_ANAF_CLIENT_SECRET=
ACCOUNTING_ANAF_REDIRECT_URI=
# test (default) or prod
ACCOUNTING_ANAF_ENVIRONMENT=test
PORT=8089
# Legacy paid acts (acte inteligente). The legacy routes mount only when DATABASE_URL and
# STRIPE_SECRET_KEY are set; leave them commented out for accounting-only deployments.
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_300=
# STRIPE_PRICE_1000=
# STRIPE_PRICE_5000=
# Signing secret (whsec_...) of the Stripe webhook endpoint <api>/stripe-webhook; the webhook mounts only when set.
# STRIPE_WEBHOOK_SECRET=
# LEGACY_ALLOWED_ORIGINS=https://xfactura.ro
