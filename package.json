{
  "name": "xfactura",
  "private": true,
  "license": "MPL-2.0",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "packages/xfactura-core",
    "packages/xfactura-web",
    "packages/xfactura-api"
  ],
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:web": "bun run --cwd packages/xfactura-web dev",
    "dev:api": "bun --watch packages/xfactura-api/source/index.ts",
    "worker": "bun run packages/xfactura-api/source/engine/worker.ts",
    "db:migrate": "bun run packages/xfactura-api/source/engine/migrate.ts",
    "account:create": "bun run packages/xfactura-api/source/engine/manage.ts create-user",
    "test": "bun test packages/xfactura-core/test",
    "test:integration": "bun test --timeout 120000 packages/xfactura-api/test/engine/*.integration.test.ts",
    "test:e2e": "bun run scripts/e2e.ts",
    "typecheck": "tsc -p packages/xfactura-core --noEmit && tsc -p packages/xfactura-core/test --noEmit && tsc -p packages/xfactura-api --noEmit && tsc -p packages/xfactura-web --noEmit",
    "lint": "eslint packages/xfactura-core packages/xfactura-api/source/engine packages/xfactura-api/test/engine packages/xfactura-web/app/contabilitate packages/xfactura-web/components/accounting",
    "build": "bun run --cwd packages/xfactura-web build",
    "check": "bun run test && bun run typecheck && bun run lint && bun run build",
    "db:generate": "bun run --cwd packages/xfactura-api db:generate",
    "setup": "bun run scripts/setup.ts",
    "build:api": "bun run --cwd packages/xfactura-api build",
    "format:check": "prettier --check packages/xfactura-core packages/xfactura-api/source/engine packages/xfactura-api/test/engine packages/xfactura-web/components/accounting packages/xfactura-web/app/contabilitate scripts test/e2e",
    "backup": "bun run packages/xfactura-api/source/engine/backup.ts backup",
    "restore": "bun run packages/xfactura-api/source/engine/backup.ts restore",
    "test:perf": "bun test --timeout 600000 packages/xfactura-api/test/engine/*.perf.test.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/bun": "1.4.4",
    "eslint": "9.39.5",
    "fast-check": "4.10.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "overrides": {
    "@types/express": "4.17.21",
    "@types/express-serve-static-core": "4.19.7",
    "@types/node": "26.6.5"
  }
}
